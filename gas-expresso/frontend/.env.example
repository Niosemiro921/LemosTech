# API existente
VITE_API_BASE_URL=http://localhost:5048/api/v1

# Tempo real: deixar vazio enquanto o backend não publicar o endereço oficial.
VITE_REALTIME_URL=

# Raio operacional configurado pelo produto; exemplo: 5
VITE_DRIVER_OFFER_RADIUS_KM=

# Logout server-side, se existir no contrato da API.
VITE_AUTH_LOGOUT_PATH=/auth/logout

