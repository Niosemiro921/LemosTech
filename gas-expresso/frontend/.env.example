# API existente
VITE_API_BASE_URL=http://localhost:5048/api/v1

# Tempo real: deixar vazio enquanto o backend não publicar o endereço oficial.
VITE_REALTIME_URL=

# Raio operacional configurado pelo produto; exemplo: 5
VITE_DRIVER_OFFER_RADIUS_KM=

# Logout server-side, se existir no contrato da API.
VITE_AUTH_LOGOUT_PATH=

# Levantamento do entregador, se existir no contrato da API.
VITE_DRIVER_WITHDRAWAL_PATH=
VITE_DRIVER_WITHDRAWALS_PATH=

# Gestão administrativa de solicitações de recarga, se existir no contrato da API.
VITE_ADMIN_WALLET_TOPUPS_PATH=/admin/wallet/top-ups
VITE_ADMIN_WALLET_TOPUP_CONFIRM_PATH_TEMPLATE=/admin/wallet/top-ups/:id/confirm
VITE_ADMIN_WALLET_TOPUP_REJECT_PATH_TEMPLATE=/admin/wallet/top-ups/:id/reject
