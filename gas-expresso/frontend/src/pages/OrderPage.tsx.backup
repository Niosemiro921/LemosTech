import { useEffect, useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { fetchGasProducts, formatAOA } from '../services/catalog';
import { useOrderStore } from '../stores/orderStore';
import { RealMap } from '../components/RealMap';
import { reverseGeocode, searchAddress, type GeocodingResult } from '../services/geocoding';
import type { DeliveryType } from '../types/gas';
import { createQuote, type QuotePricingView } from '../services/quote';
import { extractMessage } from '../services/auth';
import type { GasProduct } from '../types/gas';


export default function OrderPage() {
  const navigate = useNavigate();
  const {
    selectedProduct,
    quantity,
    address,
    deliveryType,
    scheduledAt,
    changeForAmount,
    bottleExchangeType,
    bottleBrand,
    valveType,
    deliveryNotes,
    setProduct,
    setQuantity,
    setAddress,
    setDeliveryType,
    setScheduledAt,
    setChangeForAmount,
    setBottleExchangeType,
    setBottleBrand,
    setValveType,
    setDeliveryNotes,
  } = useOrderStore();
  const [locationStatus, setLocationStatus] = useState<'idle' | 'loading' | 'success' | 'error'>('idle');
  const [locationMessage, setLocationMessage] = useState('Ative a localização para encontrarmos a melhor entrega.');
  const [addressQuery, setAddressQuery] = useState('');
  const [searchResults, setSearchResults] = useState<GeocodingResult[]>([]);
  const [searchingAddress, setSearchingAddress] = useState(false);
  const [mapResolving, setMapResolving] = useState(false);
  const [products, setProducts] = useState<GasProduct[]>([]);
  const [catalogError, setCatalogError] = useState('');
  const [quote, setQuote] = useState<QuotePricingView | null>(null);
  const [quoteLoading, setQuoteLoading] = useState(false);
  const [quoteError, setQuoteError] = useState('');
  const chosen = products.find((product) => product.id === selectedProduct?.id) ?? products[0] ?? null;

  useEffect(() => {
    let active = true;
    fetchGasProducts().then((items) => {
      if (!active) return;
      setProducts(items);
      if (items.length && !items.some((item) => item.id === selectedProduct?.id)) setProduct(items[0]);
    }).catch((cause: unknown) => {
      if (active) setCatalogError(extractMessage(cause, 'Não foi possível carregar o catálogo.'));
    });
    return () => { active = false; };
  }, [selectedProduct?.id, setProduct]);

  useEffect(() => {
    if (!chosen || !address || address.lat == null || address.lng == null) {
      setQuote(null);
      return;
    }
    let active = true;
    setQuoteLoading(true);
    setQuoteError('');
    createQuote({
      product: chosen,
      quantity,
      deliveryType,
      latitude: address.lat,
      longitude: address.lng,
      deliveryAddress: address.address,
      scheduledAt,
    }).then((result) => {
      if (!active) return;
      setQuote(result);
      if (!result.available) setQuoteError(result.message ?? 'Sem disponibilidade para este endereço.');
    }).catch((cause: unknown) => {
      if (active) setQuoteError(extractMessage(cause, 'Não foi possível calcular a estimativa.'));
    }).finally(() => { if (active) setQuoteLoading(false); });
    return () => { active = false; };
  }, [chosen, quantity, deliveryType, address, scheduledAt]);

  const requestLocation = () => {
    if (!navigator.geolocation) {
      setLocationStatus('error');
      setLocationMessage('Este navegador não disponibiliza geolocalização.');
      return;
    }

    setLocationStatus('loading');
    setLocationMessage('A obter a sua localização...');

    navigator.geolocation.getCurrentPosition(
      ({ coords }) => {
        setAddress({
          label: 'Minha localização',
          address: 'Localização atual — coordenadas prontas para o mapa',
          lat: coords.latitude,
          lng: coords.longitude,
          accuracy: Math.round(coords.accuracy),
        });
        setLocationStatus('success');
        setLocationMessage(`Localização obtida com precisão aproximada de ${Math.round(coords.accuracy)} m.`);
      },
      () => {
        setLocationStatus('error');
        setLocationMessage('Não foi possível obter a localização. Verifique a permissão do navegador.');
      },
      { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 },
    );
  };


  const applyGeocodingResult = (result: GeocodingResult) => {
    setAddress({
      label: 'Local de entrega',
      address: result.displayName,
      lat: result.lat,
      lng: result.lng,
      accuracy: undefined,
    });
    setAddressQuery(result.displayName);
    setSearchResults([]);
    setLocationStatus('success');
    setLocationMessage('Ponto de entrega definido. Pode ajustar o pin no mapa.');
  };

  const handleAddressSearch = async (event: React.FormEvent) => {
    event.preventDefault();
    if (addressQuery.trim().length < 3) {
      setLocationStatus('error');
      setLocationMessage('Digite pelo menos 3 caracteres para pesquisar o endereço.');
      return;
    }

    setSearchingAddress(true);
    setLocationStatus('loading');
    setLocationMessage('A procurar o endereço...');
    try {
      const results = await searchAddress(addressQuery);
      setSearchResults(results);
      setLocationStatus(results.length ? 'success' : 'error');
      setLocationMessage(results.length ? 'Selecione um resultado ou ajuste o pin no mapa.' : 'Não encontramos esse endereço em Angola.');
    } catch {
      setLocationStatus('error');
      setLocationMessage('Não foi possível pesquisar agora. Tente novamente.');
    } finally {
      setSearchingAddress(false);
    }
  };

  const handleMapChange = async ({ lat, lng }: { lat: number; lng: number }) => {
    setMapResolving(true);
    setLocationStatus('loading');
    setLocationMessage('A identificar o ponto selecionado...');
    try {
      const result = await reverseGeocode(lat, lng);
      setAddress({
        label: 'Ponto selecionado no mapa',
        address: result?.displayName ?? `Coordenadas ${lat.toFixed(5)}, ${lng.toFixed(5)}`,
        lat,
        lng,
        accuracy: undefined,
      });
      setAddressQuery(result?.displayName ?? 'Ponto selecionado no mapa');
      setLocationStatus('success');
      setLocationMessage('Ponto de entrega definido. Pode continuar.');
    } catch {
      setAddress({
        label: 'Ponto selecionado no mapa',
        address: `Coordenadas ${lat.toFixed(5)}, ${lng.toFixed(5)}`,
        lat,
        lng,
        accuracy: undefined,
      });
      setAddressQuery('Ponto selecionado no mapa');
      setLocationStatus('success');
      setLocationMessage('Ponto definido pelas coordenadas.');
    } finally {
      setMapResolving(false);
    }
  };

  const continueOrder = () => {
    if (!chosen || !products.length) {
      setCatalogError('O catálogo ainda não está disponível.');
      return;
    }
    if (!address) {
      requestLocation();
      return;
    }
    if (deliveryType === 'scheduled' && !scheduledAt) return;
    if (!quote?.available) return;
    navigate('/confirmar');
  };

  const minSchedule = new Date(Date.now() + 60 * 60 * 1000);
  const minScheduleValue = new Date(minSchedule.getTime() - minSchedule.getTimezoneOffset() * 60000).toISOString().slice(0, 16);

  return (
    <div className="page order-page">
      <div className="page-heading order-heading">
        <div>
          <span className="section-kicker">Novo pedido</span>
          <h1>Peça o seu gás.</h1>
          <p>Escolha a botija, indique onde entregar e veja a estimativa antes de confirmar.</p>
        </div>
        <div className="order-progress" aria-label="Progresso do pedido">
          <span className="active">1</span><i /><span>2</span><i /><span>3</span>
        </div>
      </div>

      <div className="order-layout">
        <section className="order-main">
          <div className="step-card">
            <div className="step-head"><span className="step-number">01</span><div><h2>Escolha a botija</h2><p>Selecione o tamanho que precisa.</p></div></div>
            {catalogError && <div className="form-error" role="alert">{catalogError}</div>}
            {!products.length && !catalogError && <p role="status">A carregar produtos disponíveis…</p>}
            <div className="product-grid">
              {products.map(product => (
                <button key={product.id} onClick={() => setProduct(product)} className={`product-card ${chosen?.id === product.id ? 'selected' : ''}`} aria-pressed={chosen?.id === product.id}>
                  {product.popular && <span className="popular-badge">Mais pedido</span>}
                  <div className="cylinder">GÁS</div>
                  <strong>{product.label}</strong>
                  <span>{formatAOA(product.price)}</span>
                  <small>{product.description}</small>
                </button>
              ))}
            </div>
            <div className="quantity-row">
              <div><strong>Quantidade</strong><small>Máximo de 20 unidades por pedido na V1.</small></div>
              <div className="qty-control" aria-label="Quantidade">
                <button onClick={() => setQuantity(quantity - 1)} disabled={quantity === 1} aria-label="Diminuir">−</button>
                <strong>{quantity}</strong>
                <button onClick={() => setQuantity(quantity + 1)} disabled={quantity === 20} aria-label="Aumentar">+</button>
              </div>
            </div>
          </div>

          <div className="step-card">
            <div className="step-head">
              <span className="step-number">02</span>
              <div>
                <h2>Detalhes do gás e troco</h2>
                <p>Indique o tipo de troca, a marca e se precisa de troco em dinheiro.</p>
              </div>
            </div>

            <div style={{ marginBottom: '1.25rem' }}>
              <label style={{ display: 'block', marginBottom: '0.5rem', fontSize: '0.9rem', fontWeight: 600 }}>
                Tipo de fornecimento
              </label>
              <div className="delivery-options">
                <button
                  type="button"
                  className={bottleExchangeType === 'REFILL_EXCHANGE' ? 'delivery-option selected' : 'delivery-option'}
                  onClick={() => setBottleExchangeType('REFILL_EXCHANGE')}
                >
                  <span>🔄</span>
                  <div>
                    <strong>Troca de botija vazia (Recarga)</strong>
                    <small>Entrega o vasilhame vazio da mesma tara</small>
                  </div>
                </button>
                <button
                  type="button"
                  className={bottleExchangeType === 'NEW_BOTTLE' ? 'delivery-option selected' : 'delivery-option'}
                  onClick={() => setBottleExchangeType('NEW_BOTTLE')}
                >
                  <span>🆕</span>
                  <div>
                    <strong>Garrafa completa (Casco + Carga)</strong>
                    <small>Não tenho botija vazia para entregar</small>
                  </div>
                </button>
              </div>
            </div>

            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))', gap: '1rem', marginBottom: '1.25rem' }}>
              <div className="field">
                <label>Marca da botija</label>
                <select
                  className="input"
                  value={bottleBrand}
                  onChange={(e) => setBottleBrand(e.target.value)}
                >
                  <option value="Sonangol">Sonangol / Sonagás</option>
                  <option value="Rubis Gás">Rubis Gás</option>
                  <option value="Galp">Galp Energia</option>
                  <option value="TotalEnergies">TotalEnergies</option>
                  <option value="Puma Energy">Puma Energy</option>
                  <option value="Outra">Outra marca compatível</option>
                </select>
              </div>

              <div className="field">
                <label>Tipo de válvula / redutor</label>
                <select
                  className="input"
                  value={valveType}
                  onChange={(e) => setValveType(e.target.value)}
                >
                  <option value="QUICK_20MM">Válvula Rápida 20mm (Padrão)</option>
                  <option value="QUICK_22MM">Válvula Rápida 22mm</option>
                  <option value="THREAD_SCREW">Rosca / Tradicional</option>
                </select>
              </div>
            </div>

            <div style={{ marginBottom: '1.25rem' }}>
              <label style={{ display: 'block', marginBottom: '0.5rem', fontSize: '0.9rem', fontWeight: 600 }}>
                Troco para pagamento na entrega (dinheiro vivo)
              </label>
              <div style={{ display: 'flex', flexWrap: 'wrap', gap: '0.5rem' }}>
                {[
                  { label: 'Valor exato / Sem troco', value: null },
                  { label: 'Troco para 5.000 Kz', value: 5000 },
                  { label: 'Troco para 10.000 Kz', value: 10000 },
                  { label: 'Troco para 20.000 Kz', value: 20000 },
                ].map((opt) => (
                  <button
                    key={opt.label}
                    type="button"
                    className={`secondary-btn ${changeForAmount === opt.value ? 'selected-chip' : ''}`}
                    style={{
                      border: changeForAmount === opt.value ? '2px solid var(--brand, #ff6600)' : '1px solid var(--line, #e2e8f0)',
                      backgroundColor: changeForAmount === opt.value ? 'var(--brand-soft, #fff5eb)' : 'transparent',
                      fontWeight: changeForAmount === opt.value ? 700 : 500,
                      padding: '0.4rem 0.8rem',
                      borderRadius: '8px',
                      cursor: 'pointer',
                    }}
                    onClick={() => setChangeForAmount(opt.value)}
                  >
                    {opt.label}
                  </button>
                ))}
              </div>
            </div>

            <div className="field">
              <label>Ponto de referência / Instruções para o entregador</label>
              <input
                className="input"
                value={deliveryNotes}
                onChange={(e) => setDeliveryNotes(e.target.value)}
                placeholder="Ex.: Portão azul, ao lado da padaria, tocar campainha 2"
              />
            </div>
          </div>

          <div className="step-card">
            <div className="step-head"><span className="step-number">03</span><div><h2>Quando quer receber?</h2><p>Escolha entre urgência ou planeamento.</p></div></div>
            <div className="delivery-options">
              <button className={deliveryType === 'express' ? 'delivery-option selected' : 'delivery-option'} onClick={() => setDeliveryType('express')} aria-pressed={deliveryType === 'express'}>
                <span>⚡</span><div><strong>Entrega expressa</strong><small>Prioridade · estimativa 20–40 min</small></div>                <b>{deliveryType === 'express' && quote?.available ? `+ ${formatAOA(quote.deliveryFee)}` : 'Preço calculado no endereço'}</b>
              </button>
              <button className={deliveryType === 'scheduled' ? 'delivery-option selected' : 'delivery-option'} onClick={() => setDeliveryType('scheduled')} aria-pressed={deliveryType === 'scheduled'}>
                <span>◷</span><div><strong>Entrega programada</strong><small>Escolha um horário mais conveniente</small></div><b>{deliveryType === 'scheduled' && quote?.available ? `+ ${formatAOA(quote.deliveryFee)}` : 'Preço calculado no endereço'}</b>
              </button>
            </div>
            {deliveryType === 'scheduled' && (
              <div className="scheduled-field">
                <label htmlFor="scheduledAt">Data e hora</label>
                <input id="scheduledAt" className="input" type="datetime-local" min={minScheduleValue} value={scheduledAt ?? ''} onChange={(event) => setScheduledAt(event.target.value || null)} />
              </div>
            )}
          </div>

          <div className="step-card">
            <div className="step-head"><span className="step-number">04</span><div><h2>Local de entrega</h2><p>O sistema usa esta posição para calcular disponibilidade, distância e rota.</p></div></div>
            <form className="address-search" onSubmit={handleAddressSearch}>
              <div className="address-search-field">
                <span>⌕</span>
                <input
                  className="input"
                  value={addressQuery}
                  onChange={(event) => setAddressQuery(event.target.value)}
                  placeholder="Pesquise rua, bairro ou município"
                  aria-label="Pesquisar endereço"
                />
              </div>
              <button className="secondary-btn" type="submit" disabled={searchingAddress}>
                {searchingAddress ? 'A pesquisar…' : 'Pesquisar'}
              </button>
            </form>

            {searchResults.length > 0 && (
              <div className="address-results">
                {searchResults.map((result, index) => (
                  <button key={`${result.lat}-${result.lng}-${index}`} className="address-result" type="button" onClick={() => applyGeocodingResult(result)}>
                    <span className="result-pin">⌖</span>
                    <span><strong>{result.displayName}</strong><small>Selecionar este ponto</small></span>
                    <span>→</span>
                  </button>
                ))}
              </div>
            )}

            <button className={`location-picker ${locationStatus}`} onClick={requestLocation} disabled={locationStatus === 'loading' || mapResolving} type="button">
              <span className="location-icon">⌖</span>
              <div><strong>{address?.label ?? 'Usar a minha localização'}</strong><small>{locationStatus === 'loading' ? 'A identificar a localização…' : locationMessage}</small></div>
              <span>{locationStatus === 'success' ? '✓' : '→'}</span>
            </button>
            <RealMap compact value={address?.lat != null && address?.lng != null ? { lat: address.lat, lng: address.lng } : null} onChange={handleMapChange} />
            {address && <div className="selected-location-card"><span>✓</span><div><strong>Ponto de entrega</strong><small>{address.address}</small></div></div>}
            {address && quoteLoading && <p role="status">A validar endereço, stock e preço com o servidor…</p>}
            {quote?.available && <div className="coverage-card available"><div className="coverage-icon">✓</div><div className="coverage-content"><strong>Disponibilidade confirmada</strong><span>Empresa: {quote.supplier?.tradeName ?? 'Parceiro local'}</span>{quote.distanceKm != null && <div className="coverage-meta"><span>{quote.distanceKm.toFixed(1)} km</span>{quote.estimatedMinutes && <span>≈ {quote.estimatedMinutes[0]}–{quote.estimatedMinutes[1]} min</span>}</div>}</div></div>}
            {quoteError && <div className="coverage-card unavailable" role="alert"><div className="coverage-icon">!</div><div className="coverage-content"><strong>Não foi possível confirmar disponibilidade</strong><span>{quoteError}</span></div></div>}
            <p className="map-help">Disponibilidade, stock e preço são consultados ao servidor antes da criação do pedido.</p>
          </div>
        </section>

        <aside className="order-summary">
          <div className="summary-top"><span>Resumo do pedido</span><span className="secure">● Seguro</span></div>
          <div className="summary-product"><div className="cylinder small">GÁS</div><div><strong>{chosen ? `${quantity} × ${chosen.label}` : 'A carregar catálogo…'}</strong><small>Preço validado pelo servidor</small></div></div>
          <div className="summary-lines">
            <div><span>Produtos</span><strong>{quote?.available ? formatAOA(quote.subtotal) : '—'}</strong></div>
            <div><span>Entrega</span><strong>{quote?.available ? formatAOA(quote.deliveryFee) : '—'}</strong></div>
            <div><span>Comissão Gás Expresso</span><strong>{quote?.available ? formatAOA(quote.platformFee) : '—'}</strong></div>
            {quote?.available && quote.discount > 0 && <div><span>Desconto</span><strong>- {formatAOA(quote.discount)}</strong></div>}
          </div>
          <div className="summary-total"><span>Total estimado</span><strong>{quote?.available ? formatAOA(quote.total) : '—'}</strong></div>
          <button className="primary-btn full" onClick={continueOrder} disabled={locationStatus === 'loading' || quoteLoading || !chosen || (deliveryType === 'scheduled' && !scheduledAt) || Boolean(address && !quote?.available)}>
            {!address ? 'Definir localização' : quoteLoading ? 'A validar disponibilidade…' : quote?.available ? 'Continuar para confirmação' : 'Disponibilidade indisponível'} <span>→</span>
          </button>
          <p className="summary-note">O preço é calculado pelo servidor e validado novamente ao confirmar.</p>
        </aside>
      </div>
      <Link to="/" className="back-link">← Voltar para início</Link>
    </div>
  );
}
