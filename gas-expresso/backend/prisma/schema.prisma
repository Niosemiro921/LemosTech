generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  DRIVER
  PRESTADOR
  SUPPLIER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING_REVIEW
  DOCUMENTS_REQUIRED
  REJECTED
  SUSPENDED
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  phone          String
  email          String?          @unique
  name           String?
  passwordHash   String
  role           UserRole
  status         AccountStatus    @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  reviewedAt     DateTime?
  reviewNote     String?

  customer       CustomerProfile?
  driver         DriverProfile?
  supplier       SupplierProfile?
  customerOrders Order[]          @relation("CustomerOrders")
  addresses      CustomerAddress[]
  notifications  Notification[]
  supportTickets SupportTicket[]
  incidents      Incident[]
  documents      BusinessDocument[]
  chatAsCustomer ChatThread[] @relation("ChatCustomer")
  chatAsProfessional ChatThread[] @relation("ChatProfessional")
  chatMessages ChatMessage[] @relation("ChatMessagesSent")
  supplierCustomerInteractions SupplierCustomerInteraction[]
  callsMade     CallSession[] @relation("CallsMade")
  callsReceived CallSession[] @relation("CallsReceived")

  @@unique([phone, role])
  @@index([phone])
  @@index([role, status])
}

model RevokedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model CustomerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  fullName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerAddress {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  label        String
  address      String
  reference    String?
  municipality String?
  province     String?
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  message   String
  type      String   @default("INFO")
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model SupportTicket {
  id        String   @id @default(uuid()) @db.Uuid
  reference String   @unique
  userId    String   @db.Uuid
  category  String
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Incident {
  id          String   @id @default(uuid()) @db.Uuid
  reference   String   @unique
  userId      String   @db.Uuid
  orderId     String?  @db.Uuid
  category    String
  severity    String
  status      String   @default("OPEN")
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, severity])
}

model BusinessDocument {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  type       String
  name       String
  status     String    @default("PENDING_REVIEW")
  expiresAt  DateTime?
  reviewNote String?
  uploadedAt DateTime  @default(now())
  reviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, uploadedAt])
  @@index([status, expiresAt])
}

model SupplierSchedule {
  id         String   @id @default(uuid()) @db.Uuid
  supplierId String   @db.Uuid
  dayOfWeek  Int
  enabled    Boolean  @default(false)
  openTime   String?
  closeTime  String?
  updatedAt  DateTime @updatedAt

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, dayOfWeek])
}

enum SupplierLotStatus {
  IN_PRODUCTION
  COMPLETED
  DISTRIBUTED
}

model SupplierProductionLot {
  id           String            @id @default(uuid()) @db.Uuid
  supplierId   String            @db.Uuid
  code         String
  productionAt DateTime
  quantity     Int
  status       SupplierLotStatus  @default(IN_PRODUCTION)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, code])
  @@index([supplierId, productionAt])
  @@index([supplierId, status])
}

enum SupplierInvoiceType {
  SALE
  PURCHASE
}

enum SupplierInvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

model SupplierInvoice {
  id            String                  @id @default(uuid()) @db.Uuid
  supplierId    String                  @db.Uuid
  number        String
  type          SupplierInvoiceType
  status        SupplierInvoiceStatus   @default(PENDING)
  amount        Int
  issueDate     DateTime
  dueDate       DateTime?
  paidAt        DateTime?
  description   String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, number])
  @@index([supplierId, issueDate])
  @@index([supplierId, status])
}

enum SupplierCustomerInteractionType {
  NOTE
  CALL
  FOLLOW_UP
}

model SupplierCustomerInteraction {
  id           String                           @id @default(uuid()) @db.Uuid
  supplierId   String                           @db.Uuid
  customerId   String                           @db.Uuid
  type         SupplierCustomerInteractionType
  subject      String
  message      String
  nextActionAt DateTime?
  createdAt    DateTime                         @default(now())

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  customer User            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([supplierId, customerId, createdAt])
  @@index([supplierId, nextActionAt])
}

model DriverWallet {
  id                      String   @id @default(uuid()) @db.Uuid
  driverId                String   @unique @db.Uuid
  balance                 Int      @default(0)
  reservedBalance         Int      @default(0)
  minimumOperatingBalance Int      @default(10000)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  driver       DriverProfile       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  topUps       WalletTopUp[]
  withdrawals  WalletWithdrawal[]

  @@index([balance, reservedBalance])
}

enum WalletTransactionType {
  TOP_UP
  WITHDRAWAL
  ADJUSTMENT
}

model WalletTransaction {
  id           String                @id @default(uuid()) @db.Uuid
  walletId     String                @db.Uuid
  type         WalletTransactionType
  amount       Int
  balanceAfter Int
  description  String
  reference    String?
  createdAt    DateTime              @default(now())

  wallet DriverWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

enum WalletTopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

model WalletTopUp {
  id           String            @id @default(uuid()) @db.Uuid
  walletId     String            @db.Uuid
  amount       Int
  status       WalletTopUpStatus @default(PENDING)
  reference    String            @unique
  reviewNote   String?
  reviewedById String?           @db.Uuid
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  reviewedAt   DateTime?

  wallet DriverWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([walletId, createdAt])
}


enum WalletWithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model WalletWithdrawal {
  id             String                  @id @default(uuid()) @db.Uuid
  walletId       String                  @db.Uuid
  amount         Int
  fee            Int                     @default(0)
  cashAmount     Int
  method         String
  account        String
  status         WalletWithdrawalStatus  @default(PENDING)
  reference      String                  @unique
  reviewNote     String?
  requestedAt    DateTime                @default(now())
  approvedAt     DateTime?
  paidAt         DateTime?
  reviewedById   String?                 @db.Uuid
  paidById       String?                 @db.Uuid

  wallet DriverWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, requestedAt])
  @@index([status, requestedAt])
}

model DriverProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  fullName              String
  documentNumber        String
  nif                   String?
  driverLicenseNumber   String?
  driverLicensePhotoUrl String?
  photoUrl              String?
  vehiclePhotoUrl       String?
  vehiclePlate          String?
  vehicleType           String
  vehicleCapacityKg     Int      @default(45)
  experienceYears       Int      @default(0)
  province              String?
  municipality          String?
  neighborhood          String?
  address               String?
  insurancePolicyNumber String?
  insuranceExpiresAt    DateTime?
  latitude              Float?
  longitude             Float?
  lastLocationAt        DateTime?
  isOnline              Boolean  @default(false)
  ratingAverage         Float    @default(5)
  acceptanceRate        Float    @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers     DriverOffer[]
  deliveries Delivery[]
  wallet     DriverWallet?

  @@index([documentNumber])
  @@index([nif])
  @@index([vehiclePlate])
  @@index([isOnline, latitude, longitude])
}

model SupplierProfile {
  id                        String            @id @default(uuid()) @db.Uuid
  userId                    String            @unique @db.Uuid
  legalName                 String
  tradeName                 String
  nif                       String
  commercialRegistration   String?
  activity                  String?
  responsibleName           String
  phoneAlt                  String?
  province                  String?
  municipality              String?
  neighborhood              String?
  address                   String?
  photoUrl                  String?
  latitude                  Float?
  longitude                 Float?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory     InventoryItem[]
  orders        Order[]
  schedules     SupplierSchedule[]
  lots          SupplierProductionLot[]
  invoices      SupplierInvoice[]
  interactions  SupplierCustomerInteraction[]

  @@index([nif])
  @@index([latitude, longitude])
}

enum AdminReviewAction {
  APPROVED
  REJECTED
  DOCUMENTS_REQUESTED
  PARTNER_SUSPENDED
  PARTNER_REACTIVATED
  DISPATCH_RETRIED
  WALLET_TOP_UP_APPROVED
  WALLET_TOP_UP_REJECTED
  WALLET_WITHDRAWAL_APPROVED
  WALLET_WITHDRAWAL_REJECTED
  WALLET_WITHDRAWAL_PAID
  EMAIL_SENT
}

model ChatThread {
  id             String       @id @default(uuid()) @db.Uuid
  orderId        String       @unique @db.Uuid
  customerId     String       @db.Uuid
  professionalId String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer     User          @relation("ChatCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  professional User          @relation("ChatProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@index([customerId, updatedAt])
  @@index([professionalId, updatedAt])
}

model ChatMessage {
  id        String     @id @default(uuid()) @db.Uuid
  threadId  String     @db.Uuid
  senderId  String     @db.Uuid
  message   String
  createdAt DateTime   @default(now())
  readAt    DateTime?

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User       @relation("ChatMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([senderId, createdAt])
}

model AuditLog {
  id           String            @id @default(uuid()) @db.Uuid
  actorUserId  String            @db.Uuid
  targetUserId String?           @db.Uuid
  action       AdminReviewAction
  reason       String?
  entity       String            @default("PARTNER")
  entityId     String?
  createdAt    DateTime          @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entity, entityId, createdAt])
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique
  name        String
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
}

model ProductVariant {
  id            String          @id @default(uuid()) @db.Uuid
  productId     String          @db.Uuid
  sku           String          @unique
  name          String
  weightKg      Int
  unitPrice     Int
  /// Preço do cilindro novo (hardware). Na troca não é cobrado: o cliente já é dono da botija.
  cylinderPrice Int             @default(0)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    InventoryItem[]
  orderItems   OrderItem[]

  @@index([productId, active])
  @@index([weightKg, active])
}

enum InventoryMovementType {
  STOCK_IN
  RESERVE
  RELEASE
  OUTBOUND
  ADJUSTMENT
}

model InventoryItem {
  id           String          @id @default(uuid()) @db.Uuid
  supplierId   String          @db.Uuid
  variantId    String          @db.Uuid
  availableQty Int             @default(0)
  reservedQty  Int             @default(0)
  reorderLevel Int             @default(5)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  supplier  SupplierProfile      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variant   ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@unique([supplierId, variantId])
  @@index([variantId, availableQty])
}

model InventoryMovement {
  id          String                 @id @default(uuid()) @db.Uuid
  inventoryId String                 @db.Uuid
  orderId     String?                @db.Uuid
  type        InventoryMovementType
  quantity    Int
  note        String?
  createdAt   DateTime               @default(now())

  inventory InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  order     Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([orderId, createdAt])
}

enum DeliveryType {
  EXPRESS
  SCHEDULED
}

enum PaymentMethod {
  PAY_ON_DELIVERY
}

enum OrderStatus {
  CREATED
  AWAITING_SUPPLIER_ACCEPTANCE
  SUPPLIER_ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  DRIVER_SEARCHING
  DRIVER_ASSIGNED
  DRIVER_ACCEPTED
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  COMPLETED
  CANCELLED
  FAILED
}

model Order {
  id                    String       @id @default(uuid()) @db.Uuid
  reference             String       @unique
  idempotencyKey        String?      @unique
  customerId            String       @db.Uuid
  supplierId            String?      @db.Uuid
  status                OrderStatus  @default(CREATED)
  deliveryType          DeliveryType
  paymentMethod         PaymentMethod @default(PAY_ON_DELIVERY)
  scheduledAt           DateTime?
  deliveryAddress       String
  latitude              Float
  longitude             Float
  subtotal              Int
  deliveryFee           Int
  platformFee           Int
  discount              Int          @default(0)
  /// Total cobrado pelos cilindros novos (0 na troca e na recarga pura).
  cylinderFee           Int          @default(0)
  total                 Int
  currency              String       @default("AOA")
  distanceKm            Float?
  estimatedMinutes      Int?
  pricingVersion        String       @default("v1")
  changeForAmount       Int?
  bottleExchangeType    String?      @default("REFILL_EXCHANGE")
  bottleBrand           String?      @default("Sonangol")
  valveType             String?      @default("QUICK_20MM")
  deliveryNotes         String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  customer              User                  @relation("CustomerOrders", fields: [customerId], references: [id])
  supplier              SupplierProfile?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  inventoryMovements    InventoryMovement[]
  delivery              Delivery?
  driverOffers          DriverOffer[]
  incidents             Incident[]
  chatThread            ChatThread?
  callSessions          CallSession[]

  @@index([customerId, createdAt])
  @@index([supplierId, status, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @db.Uuid
  variantId     String         @db.Uuid
  variantName   String
  weightKg      Int
  quantity      Int
  unitPrice     Int
  lineTotal     Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}


enum DriverOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DeliveryStatus {
  ASSIGNED
  TO_PICKUP
  AT_PICKUP
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  CANCELLED
}

model DriverOffer {
  id                     String            @id @default(uuid()) @db.Uuid
  orderId                String            @db.Uuid
  driverId               String            @db.Uuid
  status                 DriverOfferStatus @default(PENDING)
  distanceToPickupKm     Float
  estimatedPickupMinutes Int
  expiresAt              DateTime
  respondedAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  order  Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([orderId, driverId])
  @@index([driverId, status, createdAt])
  @@index([orderId, status, createdAt])
}

model Delivery {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @unique @db.Uuid
  driverId         String         @db.Uuid
  status           DeliveryStatus @default(ASSIGNED)
  pickupAddress    String
  pickupLatitude   Float
  pickupLongitude  Float
  dropoffAddress   String
  dropoffLatitude  Float
  dropoffLongitude Float
  assignedAt       DateTime       @default(now())
  acceptedAt       DateTime?
  pickedUpAt       DateTime?
  arrivedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Restrict)
  statusHistory DeliveryStatusHistory[]

  @@index([driverId, status, createdAt])
  @@index([status, createdAt])
}


model DeliveryStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  deliveryId String         @db.Uuid
  status     DeliveryStatus
  note       String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime       @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
}

enum CallStatus {
  OFFERING
  RINGING
  CONNECTED
  ENDED
  REJECTED
  MISSED
}

model CallSession {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @db.Uuid
  callerId      String      @db.Uuid
  receiverId    String      @db.Uuid
  status        CallStatus  @default(OFFERING)
  sdpOffer      String?
  sdpAnswer     String?
  iceCandidates Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  endedAt       DateTime?

  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  caller        User        @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  receiver      User        @relation("CallsReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([callerId, createdAt])
  @@index([receiverId, createdAt])
}

